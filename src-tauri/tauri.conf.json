{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AMAGI Core",
  "version": "0.1.6",
  "identifier": "com.racious.amagi-core",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AMAGI Core",
        "width": 1200,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "visible": true,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRCODU0N0FCRkQ0RDcwNTQKUldSVWNFMzlxMGVGUzVhS0Z2TklMZ1oyeE5WL2wyVEdMeWJweGFlL0pUTVFTWm1SOWdMS2J3eGkK",
      "endpoints": [
        "https://github.com/Racious/Amagi-Core/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
